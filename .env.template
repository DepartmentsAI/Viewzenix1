# Viewzenix1 Backend API Environment Variables Template
# Copy this file to .env and fill in your specific values.

# Application Settings
FLASK_APP=src/backend/app.py
FLASK_ENV=development  # or production
DEBUG=True             # Set to False in production
SECRET_KEY=            # Generate a strong secret key (e.g., using os.urandom(24).hex())

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database Configuration
# Use sqlite:///viewzenix.db for local SQLite
# Use postgresql://username:password@host:port/database for PostgreSQL
DATABASE_URL=sqlite:///viewzenix.db

# Security Settings
JWT_SECRET_KEY=        # Generate another strong secret key
JWT_ACCESS_TOKEN_EXPIRES=3600 # Token expiry time in seconds (1 hour)

# Broker Integration (Optional - required for live/paper trading features)
BROKER_API_KEY=
BROKER_API_SECRET=
USE_PAPER_TRADING=True # Set to False for live trading

# Logging Configuration
LOG_LEVEL=DEBUG        # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text        # text or json
LOG_DIR=logs 