# Development Dockerfile for Viewzenix1 Frontend
FROM node:16-alpine

# Install dependencies for the health check
RUN apk add --no-cache curl

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the healthcheck script
COPY healthcheck.js .

# Start the development server
CMD ["npm", "start"] 