# Sample environment configuration for Viewzenix1 integration services
# Copy this file to .env and update the values with your actual credentials

# Alpaca Trading API Configuration
ALPACA_PAPER_API_KEY=PK12345678901234567890
ALPACA_PAPER_API_SECRET=sk_test_secretkeyvaluegoeshere12345
ALPACA_PAPER_TRADING=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

